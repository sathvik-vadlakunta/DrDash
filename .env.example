# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drdash"

# Separate database used by `pnpm test:integration`.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/drdash_test"

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-in-production"

# Force the FRED sync and catalog check to use the bundled offline JSON seeds
# instead of the network (useful in CI or airgapped environments).
# FRED_OFFLINE=1
