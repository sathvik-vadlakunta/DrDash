{
  "name": "drdash",
  "version": "0.1.0",
  "private": true,
  "description": "Dr. Dash — an interactive macroeconomic data dashboard and lesson platform for intro economics courses, built on FRED data.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "sync": "NODE_USE_ENV_PROXY=1 tsx scripts/sync.ts",
    "check:catalog": "NODE_USE_ENV_PROXY=1 tsx scripts/check-catalog.ts",
    "fetch:fred": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-fred.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:catalog && pnpm build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
